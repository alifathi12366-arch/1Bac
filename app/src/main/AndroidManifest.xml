package com.example.bac1

import android.content.Intent
import android.os.Bundle
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity

class MainActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        // تحميل تصميم الشاشة الرئيسية الأصلي
        val layoutRes = resources.getIdentifier("activity_main", "layout", packageName)
        if (layoutRes != 0) {
            setContentView(layoutRes)
        }

        // ربط أزرار المدرسين والامتحانات بدون المساس بالتصميم الأصلي
        setupNavigation()
    }

    private fun setupNavigation() {
        // زر أداء الامتحان للطلاب (أو عند الضغط على أي عنصر للتحويل)
        val btnTakeExamId = resources.getIdentifier("btnStudentExams", "id", packageName)
        if (btnTakeExamId != 0) {
            findViewById<android.view.View>(btnTakeExamId)?.setOnClickListener {
                startActivity(Intent(this, StudentExamsActivity::class.java))
            }
        }

        // زر إضافة امتحان للمدرس
        val btnAddExamId = resources.getIdentifier("btnAddExam", "id", packageName)
        if (btnAddExamId != 0) {
            findViewById<android.view.View>(btnAddExamId)?.setOnClickListener {
                startActivity(Intent(this, AddExamActivity::class.java))
            }
        }

        // زر عرض النتائج للمدرس
        val btnTeacherResultsId = resources.getIdentifier("btnTeacherResults", "id", packageName)
        if (btnTeacherResultsId != 0) {
            findViewById<android.view.View>(btnTeacherResultsId)?.setOnClickListener {
                startActivity(Intent(this, TeacherResultsActivity::class.java))
            }
        }
    }
}
