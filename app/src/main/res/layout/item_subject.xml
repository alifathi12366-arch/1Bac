<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    android:layout_marginBottom="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/iconBox"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:background="@color/teal_primary">

            <ImageView
                android:id="@+id/subjectIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/subjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/iconBox"
            android:layout_marginEnd="12dp"
            android:text="المادة"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/subjectDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/subjectName"
            android:layout_toStartOf="@id/iconBox"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:text="وصف المادة"
            android:textSize="12sp"
            android:textColor="@color/text_gray" />

        <ProgressBar
            android:id="@+id/subjectProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_below="@id/subjectDesc"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>





















