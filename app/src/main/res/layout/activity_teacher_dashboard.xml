<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/teacherWelcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أهلاً بيك أستاذ 👋"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/teacherSubjectText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/teacherExpiryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#F5A623"
            android:layout_marginBottom="20dp" />

        <!-- زرار إعداد كود الطلاب -->
        <Button
            android:id="@+id/setJoinCodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 تحديد كود طلابي" />
        <Button
            android:id="@+id/btnMyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 محتواي المنشور"
            android:backgroundTint="#795548"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/currentJoinCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#666666" />

        <!-- الإحصائيات الشاملة -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 إحصائياتك"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/studentCountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="#2196F3"
                    android:text="جاري تحميل عدد الطلاب..." />

                <TextView
                    android:id="@+id/statsAttendanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="#4CAF50"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/statsRatingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="#F5A623"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    

        <!-- قسم إضافة المحتوى الجديد -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان الدرس أو المنشور"
            android:inputType="text" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="نص الرسالة / الشرح"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etYoutubeUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رابط يوتيوب أو القناة (اختياري)"
            android:inputType="textUri"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnSelectPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 اختيار ملزمة PDF"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎥 اختيار فيديو للرفع"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/sendMessageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 نشر المحتوى لطلابي"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />
        <Button
    android:id="@+id/btnAddExam"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="📝 إضافة امتحان جديد"
    android:backgroundTint="#9C27B0"
    android:textColor="#FFFFFF"
    android:layout_marginTop="12dp" />
        <Button
            android:id="@+id/btnViewResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 نتائج امتحانات طلابي"
            android:backgroundTint="#607D8B"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
