<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/teacherWelcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="أهلاً بيك أستاذ 👋"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/teacherSubjectText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#666666"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/teacherExpiryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#F5A623"
            android:layout_marginBottom="20dp" />

        <!-- زرار إعداد كود الطلاب -->
        <Button
            android:id="@+id/setJoinCodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔑 تحديد كود طلابي" />

        <TextView
            android:id="@+id/currentJoinCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#666666" />

        <!-- عدد الطلاب المسجلين -->
        <TextView
            android:id="@+id/studentCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:text="جاري تحميل عدد الطلاب..."
            android:layout_marginBottom="20dp" />

        <!-- قسم إضافة المحتوى الجديد -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان الدرس أو المنشور"
            android:inputType="text" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="نص الرسالة / الشرح"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etYoutubeUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رابط يوتيوب أو القناة (اختياري)"
            android:inputType="textUri"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnSelectPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄 اختيار ملزمة PDF"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎥 اختيار فيديو للرفع"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/sendMessageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 نشر المحتوى لطلابي"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />
        <Button
    android:id="@+id/btnAddExam"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="📝 إضافة امتحان جديد"
    android:backgroundTint="#9C27B0"
    android:textColor="#FFFFFF"
    android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
