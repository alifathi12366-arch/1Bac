<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 المواد الدراسية"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="المواد المضافة للمجموع"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/teal_primary" />

        <include layout="@layout/item_subject" android:id="@+id/cardArabic" />
        <include layout="@layout/item_subject" android:id="@+id/cardEnglish" />
        <include layout="@layout/item_subject" android:id="@+id/cardMath" />
        <include layout="@layout/item_subject" android:id="@+id/cardScience" />
        <include layout="@layout/item_subject" android:id="@+id/cardPhilosophy" />
        <include layout="@layout/item_subject" android:id="@+id/cardHistory" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="المواد الغير مضافة للمجموع"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/red_accent" />

        <include layout="@layout/item_subject" android:id="@+id/cardProgramming" />
        <include layout="@layout/item_subject" android:id="@+id/cardIslamic" />
        <include layout="@layout/item_subject" android:id="@+id/cardFrench" />

    </LinearLayout>
</ScrollView>
