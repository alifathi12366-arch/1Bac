<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 إضافة امتحان جديد"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etExamTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان الامتحان (مثال: اختبار الشهر الأول)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="السؤال"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="textMultiLine"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etOption1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الخيار الأول (A)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etOption2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الخيار الثاني (B)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etOption3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الخيار الثالث (C)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etOption4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الخيار الرابع (D)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الإجابة الصحيحة (اكتب الرقم 1 أو 2 أو 3 أو 4)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:inputType="number"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSaveExam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 حفظ ونشر الامتحان"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
