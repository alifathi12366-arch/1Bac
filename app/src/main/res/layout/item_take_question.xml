<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="14dp"
    android:layout_marginBottom="14dp">

    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvQuestionScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#4CAF50"
        android:textSize="13sp"
        android:layout_marginBottom="10dp"/>

    <RadioGroup
        android:id="@+id/rgAnswerOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbAns1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"/>

        <RadioButton
            android:id="@+id/rbAns2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"/>

        <RadioButton
            android:id="@+id/rbAns3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"/>

        <RadioButton
            android:id="@+id/rbAns4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"/>
    </RadioGroup>

    <EditText
        android:id="@+id/etEssayAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="اكتب إجابتك هنا..."
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:background="@android:drawable/editbox_background"
        android:minLines="3"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:padding="10dp"
        android:visibility="gone"/>

</LinearLayout>
